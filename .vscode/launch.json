  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Web App",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
       "cwd": "${workspaceFolder}/web-app"
    },{
      "name": "Run Game Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/server",
      "envFile": "${workspaceFolder}/.env",
      "args": []
    }
  ]
}